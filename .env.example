# ============================================
# PROMOBOT — Configurações
# Copie este arquivo para .env e preencha
# ============================================

# Token do bot Telegram (obtenha com @BotFather)
TELEGRAM_BOT_TOKEN=seu_token_aqui

# IDs dos canais Telegram separados por vírgula
# Para obter o ID: adicione @userinfobot ao canal e envie /start
# Canais precisam do prefixo -100 (ex: -1001234567890)
TELEGRAM_CHANNEL_IDS=-1001234567890,-1009876543210

# Sua tag de afiliado do Mercado Livre
# Obtenha em: https://www.mercadolivre.com.br/afiliados
ML_AFFILIATE_TAG=seutag-55

# Desconto mínimo para postar (em %)
MIN_DISCOUNT_PERCENT=15

# Intervalo de busca em minutos
SCRAPE_INTERVAL_MINUTES=30

# Porta do painel web
WEB_PORT=3000

# Palavras-chave para buscar (separadas por vírgula)
# Deixe vazio para buscar todas as ofertas do dia
SEARCH_KEYWORDS=smartphone,notebook,tv,headphone,geladeira,air fryer

# Categorias do ML para monitorar (separadas por vírgula)
# Opções: eletronicos,informatica,eletrodomesticos,moda,esportes,casa
ML_CATEGORIES=eletronicos,informatica,eletrodomesticos
